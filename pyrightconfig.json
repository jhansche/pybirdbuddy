{
  "pythonVersion": "3.10",
  "venvPath": ".",
  "venv": "venv",
  "exclude": ["**/__pycache__", "**/.*", "build", "dist", "venv"],
  "include": ["birdbuddy", "tests", "scripts"],
  "reportIncompatibleVariableOverride": false,
  "executionEnvironments": [
    {
      "root": "tests",
      "extraPaths": ["."],
      "reportTypedDictNotRequiredAccess": false,
      "reportOptionalMemberAccess": false
    }
  ]
}
